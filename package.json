{
  "name": "swarm-wallet",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check:browserbase": "node --env-file=.env --import tsx src/check-browserbase.ts",
    "smoke": "node --env-file=.env --import tsx smoke.ts",
    "setup:context": "node --env-file=.env --import tsx src/setup-context.ts",
    "server": "node --env-file=.env --import tsx src/server.ts",
    "server:4": "MAX_BROWSER_SESSIONS=4 PREWARM_BROWSERBASE_SESSIONS=4 node --env-file=.env --import tsx src/server.ts",
    "dev:backend": "node --env-file=.env --watch --import tsx src/server.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "latest",
    "@browserbasehq/stagehand": "latest",
    "openai": "4.104.0",
    "ws": "latest",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/ws": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
