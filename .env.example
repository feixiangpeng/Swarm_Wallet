# Browserbase
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=...

# Wafer
WAFER_API_KEY=wfr_...

# Snowflake — use password OR key file (not a path in SNOWFLAKE_PRIVATE_KEY without reading)
SNOWFLAKE_ENABLED=true
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_PASSWORD=your_password

# Key-pair auth (optional — comment out PASSWORD if using JWT only)
# SNOWFLAKE_AUTH=jwt
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=   # only if .p8 is encrypted

# Or force password even if a key path is present:
# SNOWFLAKE_AUTH=password

SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SWARM_WALLET
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_ROLE=YOUR_ROLE

# Semantic search (Cortex embeddings — needs SNOWFLAKE.CORTEX_USER on your role)
SNOWFLAKE_SEMANTIC_SEARCH=true
SNOWFLAKE_EMBED_MODEL=snowflake-arctic-embed-m-v1.5
SNOWFLAKE_SIMILARITY_THRESHOLD=0.72
